{
  "name": "bookmark-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/proxy.js",
    "dev:electron": "node scripts/start-electron-dev.cjs",
